[action],\n            self.actions[(action + 2) % 4],\n            self.actions[(action + 1) % 4],\n            self.actions[(action + 3) % 4]\n        ]\n        probs = [0.75, 0.05, 0.10, 0.10]\n        chosen_move = directions[np.random.choice(4, p=probs)]\n        nx, ny = x + chosen_move[0], y + chosen_move[1]\n\n        if 0 <= nx < self.maze.shape[0] and 0 <= ny < self.maze.shape[1] and self.maze[nx][ny] != 1:\n            self.current_pos = (nx, ny)\n        else:\n            nx, ny = x, y\n\n        state_type = self.maze[nx][ny]\n        if state_type == 0:\n            reward = self.state_penalty\n        elif state_type == 2:\n            reward = self.trap_penalty\n        elif state_type == 3:\n            reward = self.goal_reward\n        else:\n            reward = self.state_penalty\n\n        return self.current_pos, reward, (state_type == 2 or state_type == 3)\n\nclass MazeTD0(MazeEnvironment):\n    def __init__(self, maze, alpha=0.1, gamma=0.95, epsilon=0.2):\n        super().__init__()\n        self.maze = maze\n        self.alpha = alpha\n        self.gamma = gamma\n        self.epsilon = epsilon\n        self.utility = np.zeros_like(maze, dtype=float)\n        self.episode_counter = 0\n\n    def choose_action(self, state):\n        if np.random.rand() < self.epsilon:\n            return np.random.choice(list(self.actions.keys()))\n        else:\n            values = []\n            for a in self.actions:\n                nx, ny = state[0] + self.actions[a][0], state[1] + self.actions[a][1]\n                if 0 <= nx < self.maze.shape[0] and 0 <= ny < self.maze.shape[1] and self.maze[nx][ny] != 1:\n                    values.append(self.utility[nx][ny])\n                else:\n                    values.append(-np.inf)\n            return int(np.argmax(values))\n\n    def update_utility_value(self, current_state, reward, new_state):\n        current_value = self.utility[current_state]\n        new_value = reward + self.gamma * self.utility[new_state]\n        self.utility[current_state] = current_value + self.alpha * (new_value - current_value)\n\n    def run(self, total_episodes, checkpoints):\n        snapshot_utilities = {}\n        diffs = []\n        prev_value = self.utility.copy()\n        for ep in range(1, total_episodes + 1):\n            state = self.reset()\n            done = False\n            while not done:\n                action = self.choose_action(state)\n                next_state, reward, done = self.step(action)\n                self.update_utility_value(state, reward, next_state)\n                state = next_state\n\n            # Save snapshot\n            if ep in checkpoints:\n                snapshot_utilities[ep] = self.utility.copy()\n\n            # Convergence difference, now continuity is more apparent in this change\n            diff = np.sum(np.abs(self.utility - prev_value))\n            diffs.append(diff)\n            prev_value = self.utility.copy()\n\n        return snapshot_utilities, diffs\n\ndef plot_convergence(episodes, diffs, title):\n    plt.figure(figsize=(8, 4))\n    plt.plot(episodes, diffs, marker='o')\n    plt.title(title)\n    plt.xlabel(\"Episode\")\n    plt.ylabel(\"|U_t - U_{t-1}|\")\n    plt.grid(True)\n    plt.tight_layout()\n    plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-05-04T00:38:47.906498Z","iopub.execute_input":"2025-05-04T00:38:47.906890Z","iopub.status.idle":"2025-05-04T00:38:47.923539Z","shell.execute_reply.started":"2025-05-04T00:38:47.906868Z","shell.execute_reply":"2025-05-04T00:38:47.922680Z"}},"outputs":[],"execution_count":18},{"cell_type":"code","source":"# Parameter testing setup\ntests = {\n    #\"alpha\": [0.001, 0.01, 0.1, 0.5, 1.0],\n    \"gamma\": [0.1, 0.25, 0.50, 0.75, 0.95],\n    \"epsilon\": [0, 0.2, 0.5, 0.8, 1.0]\n}\n\nalpha_def, gamma_def, epsilon_def = 0.1, 0.95, 0.2\ncheckpoints = [1, 50, 100, 1000, 5000, 10000]\ntotal_episodes = 10000\n\nfor param in tests:\n    for val in tests