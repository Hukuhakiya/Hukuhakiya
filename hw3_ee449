    "# Parameter testing setup\n",
    "tests = {\n",
    "    #\"alpha\": [0.001, 0.01, 0.1, 0.5, 1.0],\n",
    "    \"gamma\": [0.1, 0.25, 0.50, 0.75, 0.95],\n",
    "    \"epsilon\": [0, 0.2, 0.5, 0.8, 1.0]\n",
    "}\n",
    "\n",
    "alpha_def, gamma_def, epsilon_def = 0.1, 0.95, 0.2\n",
    "checkpoints = [1, 50, 100, 1000, 5000, 10000]\n",
    "total_episodes = 10000\n",
    "\n",
    "for param in tests:\n",
    "    for val in tests[param]:\n",
    "        alpha = val if param == \"alpha\" else alpha_def\n",
    "        gamma = val if param == \"gamma\" else gamma_def\n",
    "        epsilon = val if param == \"epsilon\" else epsilon_def\n",
    "\n",
    "        maze = MazeEnvironment().maze\n",
    "        agent = MazeTD0(maze, alpha=alpha, gamma=gamma, epsilon=epsilon)\n",
    "\n",
    "        print(f\"Running TD(0) for {param}={val}\")\n",
    "        start = time.time() # time duration calculated for 10000 episodes more logically\n",
    "        snapshots, diffs = agent.run(total_episodes, checkpoints)\n",
    "        end = time.time()\n",
    "\n",
    "        for chk in checkpoints:\n",
    "            print(f\"Checkpoint at {chk} episodes ({end-start:.2f}s)\")\n",
    "            plot_value_function(snapshots[chk], maze, chk)\n",
    "            plot_policy(snapshots[chk], maze, chk)\n",
    "            plt.show()\n",
    "\n",
    "        plot_convergence(list(range(1, total_episodes + 1)), diffs, f\"Convergence for {param}={val}\")"
